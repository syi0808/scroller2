{
  "name": "scroller2",
  "version": "0.0.1",
  "description": "Deterministic programmatic scrolling and target reveal engine",
  "keywords": [
    "reveal",
    "scroll",
    "scroll-into-view",
    "scrolling",
    "smooth-scroll"
  ],
  "homepage": "https://github.com/syi0808/scroller2#readme",
  "bugs": {
    "url": "https://github.com/syi0808/scroller2/issues"
  },
  "license": "MIT",
  "author": "syi0808",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syi0808/scroller2.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepack": "pnpm check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0"
}
